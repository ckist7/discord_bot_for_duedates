# ----------------------------
# COMMAND: NEXT ASSIGNMENT
# ----------------------------
@bot.command(name="assignments273")
async def assignments273(ctx):
    now = datetime.now(TZ)

    upcoming_modules = [m for m in modules if m["due"] >= now]

    if not upcoming_modules:
        await ctx.send("✅ There are no upcoming modules.")
        return

    nearest = min(upcoming_modules, key=lambda m: m["due"])

    remaining = nearest["due"] - now
    days = remaining.days
    hours, rem = divmod(remaining.seconds, 3600)
    minutes = rem // 60

    assignment_names = [
        assignment_map.get(a, {}).get("name", a)
        for a in nearest["assignments"]
    ]

    due_str = nearest["due"].strftime("%B %d, %Y at %I:%M %p %Z")

    assignment_text = "\n• ".join(assignment_names)

    message = (
        f"📘 **Next Module Due**\n"
        f"**{nearest['title']}**\n"
        f"📅 Due: {due_str}\n\n"
        f"🧾 Assignments:\n• {assignment_text}\n\n"
        f"⏳ Time Remaining: {days}d {hours}h {minutes}m"
    )

    await ctx.send(message)

